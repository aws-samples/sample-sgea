    "exempt": {
     "sgea:role": [
      "deploy-helper"
     ]
    }
   }
  ],
  "lambda-function-public-access-prohibited": [
   {
    "resource": "AWS::Lambda::Permission",
    "require": {
     "op": "not_equals",
     "value": "*"
