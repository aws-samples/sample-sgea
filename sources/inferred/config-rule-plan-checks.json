    "attribute": "Principal"
   }
  ],
  "cloudwatch-alarm-action-check": [
   {
    "resource": "AWS::CloudWatch::Alarm",
    "require": {
     "op": "set"
    },
    "attribute": "AlarmActions"
   },
   {
    "resource": "AWS::CloudWatch::Alarm",
    "require": {
     "op": "set"
    },
    "attribute": "InsufficientDataActions",
    "when_param": "insufficientDataActionRequired"
   },
   {
    "resource": "AWS::CloudWatch::Alarm",
    "require": {
     "op": "set"
    },
    "attribute": "OKActions",
    "when_param": "okActionRequired"
   }
  ],
  "sns-encrypted-kms": [
   {
    "resource": "AWS::SNS::Topic",
    "require": {
     "op": "set"
    },
    "attribute": "KmsMasterKeyId"
   }
  ],
  "secretsmanager-using-cmk": [
