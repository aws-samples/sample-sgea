 "_exemption_reasons": {
  "access-log-sink": "S3 server-access-log target: cannot log to itself; SSE-KMS targets are not supported by log delivery (SSE-S3 used); no object lock / replication needed for access logs.",
  "replica": "Cross-region replica of the log store: it is the replication destination.",
  "config-delivery": "AWS Config delivery bucket: no Object Lock because S3 rejects writes to Object Lock buckets without a checksum header and the AWS Config writer sends none (verified: InsufficientDeliveryPolicyException); not replicated \u2014 AWS Config retains configuration history itself. Otherwise identical hardening (SSE-KMS, versioning, TLS-only, access logging, lifecycle)."
 },
 "cfn_rules": {
  "s3-bucket-versioning-enabled": [
