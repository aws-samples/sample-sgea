    "resource": "AWS::RDS::DBCluster",
    "require": {
     "op": "set"
    },
    "attribute": "MasterUserSecret.KmsKeyId"
   }
  ],
  "secretsmanager-rotation-enabled-check": [
   {
    "resource": "AWS::RDS::DBCluster",
    "require": {
     "op": "equals",
     "value": true
    },
    "attribute": "ManageMasterUserPassword"
   }
  ],
  "cloudtrail-security-trail-enabled": [
   {
    "resource": "AWS::CloudTrail::Trail",
    "require": {
     "op": "equals",
     "value": true
    },
    "attribute": "IsMultiRegionTrail"
   },
   {
    "resource": "AWS::CloudTrail::Trail",
    "require": {
     "op": "equals",
     "value": true
    },
    "attribute": "EnableLogFileValidation"
   },
   {
    "resource": "AWS::CloudTrail::Trail",
    "require": {
     "op": "set"
    },
    "attribute": "KMSKeyId"
   },
   {
    "resource": "AWS::CloudTrail::Trail",
    "require": {
     "op": "equals",
     "value": true
    },
    "attribute": "IncludeGlobalServiceEvents"
   }
  ],
  "cloudtrail-s3-bucket-public-access-prohibited": [
   {
    "resource": "AWS::S3::Bucket",
    "require": {
     "op": "equals",
     "value": true
    },
    "attribute": "PublicAccessBlockConfiguration.BlockPublicAcls"
   },
   {
    "resource": "AWS::S3::Bucket",
    "require": {
     "op": "equals",
     "value": true
    },
    "attribute": "PublicAccessBlockConfiguration.BlockPublicPolicy"
   },
   {
    "resource": "AWS::S3::Bucket",
    "require": {
     "op": "equals",
     "value": true
    },
    "attribute": "PublicAccessBlockConfiguration.IgnorePublicAcls"
   },
   {
    "resource": "AWS::S3::Bucket",
    "require": {
     "op": "equals",
     "value": true
    },
    "attribute": "PublicAccessBlockConfiguration.RestrictPublicBuckets"
   }
  ],
  "s3-bucket-public-read-prohibited": [
   {
    "resource": "AWS::S3::Bucket",
    "require": {
     "op": "equals",
     "value": true
    },
    "attribute": "PublicAccessBlockConfiguration.BlockPublicAcls"
   },
   {
    "resource": "AWS::S3::Bucket",
    "require": {
     "op": "equals",
     "value": true
    },
    "attribute": "PublicAccessBlockConfiguration.BlockPublicPolicy"
   },
   {
    "resource": "AWS::S3::Bucket",
    "require": {
     "op": "equals",
     "value": true
    },
    "attribute": "PublicAccessBlockConfiguration.IgnorePublicAcls"
   },
   {
    "resource": "AWS::S3::Bucket",
    "require": {
     "op": "equals",
     "value": true
    },
    "attribute": "PublicAccessBlockConfiguration.RestrictPublicBuckets"
   }
  ],
  "s3-bucket-public-write-prohibited": [
   {
    "resource": "AWS::S3::Bucket",
    "require": {
     "op": "equals",
     "value": true
    },
    "attribute": "PublicAccessBlockConfiguration.BlockPublicAcls"
   },
   {
    "resource": "AWS::S3::Bucket",
    "require": {
     "op": "equals",
     "value": true
    },
    "attribute": "PublicAccessBlockConfiguration.BlockPublicPolicy"
   },
   {
    "resource": "AWS::S3::Bucket",
    "require": {
     "op": "equals",
     "value": true
    },
    "attribute": "PublicAccessBlockConfiguration.IgnorePublicAcls"
   },
   {
    "resource": "AWS::S3::Bucket",
    "require": {
     "op": "equals",
     "value": true
    },
    "attribute": "PublicAccessBlockConfiguration.RestrictPublicBuckets"
   }
