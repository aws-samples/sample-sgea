    "resource": "AWS::DynamoDB::Table",
    "require": {
     "op": "equals",
     "value": "PAY_PER_REQUEST"
    },
    "attribute": "BillingMode"
   }
  ],
  "s3-resources-protected-by-backup-plan": [
   {
    "resource": "AWS::Backup::BackupSelection",
    "require": {
     "op": "set"
    },
    "attribute": "BackupSelection.Resources",
    "subject": "AWS::S3::Bucket",
    "exempt": {
     "sgea:role": [
      "access-log-sink",
      "replica"
     ]
    }
   }
  ],
  "lambda-concurrency-check": [
   {
    "resource": "AWS::Lambda::Function",
    "require": {
     "op": "min"
    },
    "attribute": "ReservedConcurrentExecutions",
    "value_param": "ConcurrencyLimitLow",
    "exempt": {
     "sgea:role": [
      "deploy-helper"
     ]
    }
   },
   {
    "resource": "AWS::Lambda::Function",
    "require": {
     "op": "max"
    },
    "attribute": "ReservedConcurrentExecutions",
    "value_param": "ConcurrencyLimitHigh",
    "exempt": {
     "sgea:role": [
      "deploy-helper"
     ]
    }
   }
  ],
  "lambda-inside-vpc": [
   {
    "resource": "AWS::Lambda::Function",
